{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@smartosa/brand": ["packages/brand/src/index.ts"],
      "@smartosa/brand/*": ["packages/brand/src/*"],
      "@smartosa/core": ["packages/core/src/index.ts"],
      "@smartosa/core/*": ["packages/core/src/*"]
    },
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "target": "ES2017"
  },
  "exclude": ["node_modules", "dist", ".next"]
}
